const { initGiveaways } = require("../utils/giveaway.js"); // Adjust if it's in a utils or functions folder

module.exports = {
  name: "ready",
  once: true,
  async execute(client, getGuildData, saveData) {
    console.log(`Ready! Logged in as ${client.user.tag}`);
    
    try {
      // Ensure the function exists before calling it to prevent hard crashes
      if (typeof initGiveaways === "function") {
        await initGiveaways(client, getGuildData, saveData);
      } else {
        console.error("initGiveaways is not a valid function export.");
      }
    } catch (error) {
      console.error("Failed to initialize active giveaways:", error);
    }
  },
};
